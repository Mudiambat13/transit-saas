# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=changez-moi-une-longue-valeur-aleatoire-de-50-caracteres-minimum
QR_SIGNING_KEY=changez-moi-une-autre-valeur-aleatoire-distincte
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Mettre 0 uniquement derrière un proxy qui gère déjà HTTPS ou en test local HTTP
SECURE_SSL_REDIRECT=0
# --- PostgreSQL ---
POSTGRES_DB=transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=changez-moi
# --- JWT / limitation de débit ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN=10/min
THROTTLE_SCAN=120/min
THROTTLE_USER=600/min
LOG_LEVEL=INFO
